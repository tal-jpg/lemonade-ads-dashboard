# Demo build configuration.
#   cp .env.demo .env
#   cp google-services.demo.json google-services.json
#   npx expo prebuild --clean && cd android && ./gradlew assembleRelease
#
# The app runs entirely offline against src/services/demo — no Firebase project
# is contacted, so the placeholder config above is never used for a real call.
EXPO_PUBLIC_DEMO_MODE=1
APP_NAME=FX Pulse Demo
APP_BUNDLE_ID=com.fxpulse.app
