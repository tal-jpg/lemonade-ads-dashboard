# Copy to .env. Everything here is build-time configuration, not secrets —
# Firebase credentials come from google-services.json / GoogleService-Info.plist.

APP_NAME=FX Pulse
APP_BUNDLE_ID=com.fxpulse.app
EAS_PROJECT_ID=

SUPPORT_EMAIL=support@fxpulse.app
TERMS_URL=https://fxpulse.app/terms
PRIVACY_URL=https://fxpulse.app/privacy

# Point the app at a locally running emulator suite (dev builds only).
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=0
EXPO_PUBLIC_EMULATOR_HOST=localhost

# Paths used by EAS to inject the native Firebase config files.
# GOOGLE_SERVICES_JSON=./google-services.json
# GOOGLE_SERVICES_PLIST=./GoogleService-Info.plist
