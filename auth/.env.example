# Copy to .env and fill in. NEVER commit .env.
# Tokens are auto-refreshed by the OAuth flow once obtained.

# ---- Meta Ads ----
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://YOUR-NGROK-SUBDOMAIN.ngrok.io/oauth/meta/callback
META_ACCESS_TOKEN=
META_REFRESH_TOKEN=

# ---- Google Ads ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-NGROK-SUBDOMAIN.ngrok.io/oauth/google/callback
GOOGLE_DEVELOPER_TOKEN=
GOOGLE_REFRESH_TOKEN=

# ---- HubSpot (Thinkup) ----
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=https://YOUR-NGROK-SUBDOMAIN.ngrok.io/oauth/hubspot/callback
HUBSPOT_REFRESH_TOKEN=

# ---- Shopify (Clear Living + Solo) ----
SHOPIFY_CLEAR_LIVING_STORE=
SHOPIFY_CLEAR_LIVING_ACCESS_TOKEN=
SHOPIFY_SOLO_STORE=
SHOPIFY_SOLO_ACCESS_TOKEN=

# ---- Salesforce (Phytech) ----
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REDIRECT_URI=https://YOUR-NGROK-SUBDOMAIN.ngrok.io/oauth/salesforce/callback
SALESFORCE_REFRESH_TOKEN=
SALESFORCE_INSTANCE_URL=

# ---- Flask ----
FLASK_SECRET_KEY=
