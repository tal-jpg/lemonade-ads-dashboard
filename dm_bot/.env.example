# Copy to dm_bot/.env and fill in. NEVER commit .env.

# ---- Meta app ----
# App secret from developers.facebook.com → your app → Settings → Basic.
# Used to verify the X-Hub-Signature-256 header on every webhook.
META_APP_SECRET=

# A string you invent. Paste the same value into the Meta webhook setup form.
WEBHOOK_VERIFY_TOKEN=

# ---- Page access tokens ----
# One per connected profile. The NAME of each variable goes in rules.json
# (token_env); the value stays here.
# Instagram: the token of the Facebook Page linked to the IG professional account.
IG_PAGE_ACCESS_TOKEN=
FB_PAGE_ACCESS_TOKEN=

# ---- App ----
PORT=5001
FLASK_SECRET_KEY=
# Token for the /admin page: open /admin?token=<this>. Leave blank to disable admin.
ADMIN_TOKEN=

# Set to 1 to match and log incoming events without sending anything. Use this
# for the first day live to confirm your keywords fire on the right things.
DM_BOT_DRY_RUN=

# Set to 1 ONLY for local testing with fake payloads — it disables webhook
# signature verification. Never set this in production.
DM_BOT_SKIP_SIGNATURE=

# Optional overrides
# META_API_VERSION=v21.0
# DM_BOT_RULES=/absolute/path/to/rules.json
# DM_BOT_DB=/absolute/path/to/dm_bot.db
# LOG_LEVEL=INFO
