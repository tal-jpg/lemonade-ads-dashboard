# MongoDB connection — Atlas SRV URI or local instance
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=orbitjobs

# Session signing secret — CHANGE THIS in production
SESSION_SECRET=orbit-demo-secret-change-me

# API port
PORT=4000

# Public base URL of the SITE (used in sitemaps + the outbound interstitial).
# In production (Express serving the built frontend) this is the server's own URL.
BASE_URL=http://localhost:4000

# Origin of the React dev server, for CORS (only needed if you skip the Vite proxy)
FRONTEND_ORIGIN=http://localhost:5173

# CV storage directory
UPLOAD_DIR=./data/uploads
